{
  "id": "e8a1b9c0-4f12-4d3a-9c11-202610290001",
  "version": "2.0",
  "name": "PetTrack - Suite de Automação E2E Selenium IDE (Sprint 4)",
  "url": "http://localhost:8080",
  "tests": [
    {
      "id": "tc01-auth-rbac-403",
      "name": "CT-AUTO-01: Autenticação de Tutor e Bloqueio RBAC na Área Admin (/403)",
      "commands": [
        {
          "id": "c1-01",
          "comment": "Abre a tela de Login do PetTrack",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1-02",
          "comment": "Define resolução padrão Desktop",
          "command": "setWindowSize",
          "target": "1366x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1-03",
          "comment": "Verifica o título principal na página de Login",
          "command": "assertText",
          "target": "css=h2.fw-bold",
          "targets": [["css=h2.fw-bold", "css:finder"]],
          "value": "PetTrack"
        },
        {
          "id": "c1-04",
          "comment": "Preenche dado controlado de entrada: E-mail da Tutora (ROLE_TUTOR)",
          "command": "type",
          "target": "id=email",
          "targets": [
            ["id=email", "id"],
            ["name=email", "name"],
            ["css=#email", "css:finder"]
          ],
          "value": "ana.silva@icloud.com"
        },
        {
          "id": "c1-05",
          "comment": "Preenche dado controlado de entrada: Senha da Tutora",
          "command": "type",
          "target": "id=senha",
          "targets": [
            ["id=senha", "id"],
            ["name=senha", "name"],
            ["css=#senha", "css:finder"]
          ],
          "value": "tutor123"
        },
        {
          "id": "c1-06",
          "comment": "Clica no botão Entrar para autenticar",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [["css=button[type='submit']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c1-07",
          "comment": "Valida que o redirecionamento pós-login levou ao Portal do Tutor (Meus Pets)",
          "command": "assertElementPresent",
          "target": "xpath=//h4[contains(.,'Meus Pets')]",
          "targets": [["xpath=//h4[contains(.,'Meus Pets')]", "xpath:innerText"]],
          "value": ""
        },
        {
          "id": "c1-08",
          "comment": "Tenta acessar rota exclusiva de Administrador (/admin/pets) estando logada como ROLE_TUTOR",
          "command": "open",
          "target": "/admin/pets",
          "targets": [],
          "value": ""
        },
        {
          "id": "c1-09",
          "comment": "Valida dado de saída esperado: Bloqueio 403 - Acesso Negado pelo Spring Security",
          "command": "assertText",
          "target": "css=h2.fw-bold",
          "targets": [["css=h2.fw-bold", "css:finder"]],
          "value": "403 - Acesso Negado"
        }
      ]
    },
    {
      "id": "tc02-cadastro-pet-oracle",
      "name": "CT-AUTO-02: Login Admin e Cadastro de Novo Pet via Procedure Oracle",
      "commands": [
        {
          "id": "c2-01",
          "comment": "Acessa a página de Login",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c2-02",
          "comment": "Preenche dado controlado de entrada: E-mail do Administrador (ROLE_ADMIN)",
          "command": "type",
          "target": "id=email",
          "targets": [["id=email", "id"]],
          "value": "admin@pettrack.com"
        },
        {
          "id": "c2-03",
          "comment": "Preenche dado controlado de entrada: Senha do Administrador",
          "command": "type",
          "target": "id=senha",
          "targets": [["id=senha", "id"]],
          "value": "admin123"
        },
        {
          "id": "c2-04",
          "comment": "Submete o formulário de login administrativo",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [["css=button[type='submit']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c2-05",
          "comment": "Valida carregamento do Painel Veterinário & Clínico (/admin/dashboard)",
          "command": "assertText",
          "target": "css=h2.fw-bold",
          "targets": [["css=h2.fw-bold", "css:finder"]],
          "value": "Painel Veterinário & Clínico"
        },
        {
          "id": "c2-06",
          "comment": "Navega para o formulário de Cadastro de Novo Paciente (/admin/pets/novo)",
          "command": "open",
          "target": "/admin/pets/novo",
          "targets": [],
          "value": ""
        },
        {
          "id": "c2-07",
          "comment": "Valida abertura do formulário Cadastrar Novo Paciente",
          "command": "assertText",
          "target": "css=h2.fw-bold",
          "targets": [["css=h2.fw-bold", "css:finder"]],
          "value": "Cadastrar Novo Paciente"
        },
        {
          "id": "c2-08",
          "comment": "Preenche Nome do Pet controlado: Apollo QA",
          "command": "type",
          "target": "id=nome",
          "targets": [["id=nome", "id"]],
          "value": "Apollo QA"
        },
        {
          "id": "c2-09",
          "comment": "Preenche Espécie controlada: Cão",
          "command": "type",
          "target": "id=especie",
          "targets": [["id=especie", "id"]],
          "value": "Cão"
        },
        {
          "id": "c2-10",
          "comment": "Preenche Raça controlada: Pastor Alemão",
          "command": "type",
          "target": "id=raca",
          "targets": [["id=raca", "id"]],
          "value": "Pastor Alemão"
        },
        {
          "id": "c2-11",
          "comment": "Seleciona Sexo controlado: Macho (value=M)",
          "command": "select",
          "target": "id=sexo",
          "targets": [["id=sexo", "id"]],
          "value": "value=M"
        },
        {
          "id": "c2-12",
          "comment": "Preenche Idade controlada: 4.0 anos",
          "command": "type",
          "target": "id=idade",
          "targets": [["id=idade", "id"]],
          "value": "4.0"
        },
        {
          "id": "c2-13",
          "comment": "Preenche Peso controlado: 28.50 kg",
          "command": "type",
          "target": "id=peso",
          "targets": [["id=peso", "id"]],
          "value": "28.50"
        },
        {
          "id": "c2-14",
          "comment": "Seleciona o Tutor Responsável (Ana Paula Silva)",
          "command": "select",
          "target": "id=tutor",
          "targets": [["id=tutor", "id"]],
          "value": "index=1"
        },
        {
          "id": "c2-15",
          "comment": "Seleciona a Clínica Veterinária (VetLife Clínica Veterinária)",
          "command": "select",
          "target": "id=clinica",
          "targets": [["id=clinica", "id"]],
          "value": "index=1"
        },
        {
          "id": "c2-16",
          "comment": "Clica em Salvar Paciente acionando PKG_PETTRACK_CADASTRO.PRC_INSERT_PET",
          "command": "click",
          "target": "css=button.btn-primary[type='submit']",
          "targets": [["css=button.btn-primary[type='submit']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c2-17",
          "comment": "Valida dado de saída esperado: Apollo QA listado na tabela de Pacientes Cadastrados",
          "command": "assertElementPresent",
          "target": "xpath=//td[contains(.,'Apollo QA')]",
          "targets": [["xpath=//td[contains(.,'Apollo QA')]", "xpath:innerText"]],
          "value": ""
        }
      ]
    },
    {
      "id": "tc03-validacao-form-negativo",
      "name": "CT-AUTO-03: Validação de Campos Obrigatórios no Cadastro de Pet (Bean Validation)",
      "commands": [
        {
          "id": "c3-01",
          "comment": "Abre o formulário de cadastro de Novo Pet (/admin/pets/novo)",
          "command": "open",
          "target": "/admin/pets/novo",
          "targets": [],
          "value": ""
        },
        {
          "id": "c3-02",
          "comment": "Deixa Nome e Espécie em branco e seleciona apenas Tutor e Clínica para testar Bean Validation",
          "command": "select",
          "target": "id=tutor",
          "targets": [["id=tutor", "id"]],
          "value": "index=1"
        },
        {
          "id": "c3-03",
          "comment": "Seleciona a Clínica Veterinária",
          "command": "select",
          "target": "id=clinica",
          "targets": [["id=clinica", "id"]],
          "value": "index=1"
        },
        {
          "id": "c3-04",
          "comment": "Submete o formulário com campos obrigatórios vazios",
          "command": "click",
          "target": "css=button.btn-primary[type='submit']",
          "targets": [["css=button.btn-primary[type='submit']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c3-05",
          "comment": "Valida dado de saída esperado: Campo Nome recebe classe Bootstrap is-invalid e impede gravação",
          "command": "assertElementPresent",
          "target": "css=#nome.is-invalid",
          "targets": [["css=#nome.is-invalid", "css:finder"]],
          "value": ""
        },
        {
          "id": "c3-06",
          "comment": "Valida dado de saída esperado: Campo Espécie recebe classe Bootstrap is-invalid",
          "command": "assertElementPresent",
          "target": "css=#especie.is-invalid",
          "targets": [["css=#especie.is-invalid", "css:finder"]],
          "value": ""
        }
      ]
    },
    {
      "id": "tc04-simulador-iot-febre",
      "name": "CT-AUTO-04: Fluxo 1 - Simulador de Telemetria IoT com Detecção de Febre Crítica (40.2°C)",
      "commands": [
        {
          "id": "c4-01",
          "comment": "Acessa o Simulador de Telemetria IoT (/admin/telemetria)",
          "command": "open",
          "target": "/admin/telemetria",
          "targets": [],
          "value": ""
        },
        {
          "id": "c4-02",
          "comment": "Valida o cabeçalho do Fluxo de Negócio 1",
          "command": "assertText",
          "target": "css=h2.fw-bold",
          "targets": [["css=h2.fw-bold", "css:finder"]],
          "value": "Simulador de Telemetria IoT do Colar"
        },
        {
          "id": "c4-03",
          "comment": "Seleciona o Paciente (Apollo QA recém-cadastrado ou primeiro pet da lista)",
          "command": "select",
          "target": "id=idPet",
          "targets": [["id=idPet", "id"]],
          "value": "index=1"
        },
        {
          "id": "c4-04",
          "comment": "Aciona o preset controlado 'Cenário de Febre (40.2°C)'",
          "command": "click",
          "target": "css=button.btn-outline-danger",
          "targets": [["css=button.btn-outline-danger", "css:finder"]],
          "value": ""
        },
        {
          "id": "c4-05",
          "comment": "Verifica que o input controlado temperatura recebeu 40.2",
          "command": "assertValue",
          "target": "id=temperatura",
          "targets": [["id=temperatura", "id"]],
          "value": "40.2"
        },
        {
          "id": "c4-06",
          "comment": "Verifica que o input controlado atividade recebeu 35",
          "command": "assertValue",
          "target": "id=atividade",
          "targets": [["id=atividade", "id"]],
          "value": "35"
        },
        {
          "id": "c4-07",
          "comment": "Clica em Processar Fluxo IoT",
          "command": "click",
          "target": "css=button.btn-warning[type='submit']",
          "targets": [["css=button.btn-warning[type='submit']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c4-08",
          "comment": "Valida dado de saída esperado: Alerta clínico de febre disparado em tela",
          "command": "assertElementPresent",
          "target": "xpath=//strong[contains(.,'ALERTA DE FEBRE GERADO:')]",
          "targets": [["xpath=//strong[contains(.,'ALERTA DE FEBRE GERADO:')]", "xpath:innerText"]],
          "value": ""
        },
        {
          "id": "c4-09",
          "comment": "Valida dado de saída esperado: Novo Health Score calculado em 65.0 / 100",
          "command": "assertElementPresent",
          "target": "xpath=//span[contains(.,'65.0 / 100')]",
          "targets": [["xpath=//span[contains(.,'65.0 / 100')]", "xpath:innerText"]],
          "value": ""
        }
      ]
    },
    {
      "id": "tc05-simulador-iot-sedentarismo",
      "name": "CT-AUTO-05: Fluxo 1 - Simulador de Telemetria IoT com Detecção de Sedentarismo (10 ativ)",
      "commands": [
        {
          "id": "c5-01",
          "comment": "Acessa o Simulador de Telemetria IoT (/admin/telemetria)",
          "command": "open",
          "target": "/admin/telemetria",
          "targets": [],
          "value": ""
        },
        {
          "id": "c5-02",
          "comment": "Seleciona o Paciente (primeiro pet da lista)",
          "command": "select",
          "target": "id=idPet",
          "targets": [["id=idPet", "id"]],
          "value": "index=1"
        },
        {
          "id": "c5-03",
          "comment": "Aciona o preset controlado 'Cenário Sedentarismo (10 ativ)'",
          "command": "click",
          "target": "css=button.btn-outline-warning",
          "targets": [["css=button.btn-outline-warning", "css:finder"]],
          "value": ""
        },
        {
          "id": "c5-04",
          "comment": "Verifica que o input controlado temperatura recebeu 38",
          "command": "assertValue",
          "target": "id=temperatura",
          "targets": [["id=temperatura", "id"]],
          "value": "38"
        },
        {
          "id": "c5-05",
          "comment": "Verifica que o input controlado atividade recebeu 10",
          "command": "assertValue",
          "target": "id=atividade",
          "targets": [["id=atividade", "id"]],
          "value": "10"
        },
        {
          "id": "c5-06",
          "comment": "Clica em Processar Fluxo IoT",
          "command": "click",
          "target": "css=button.btn-warning[type='submit']",
          "targets": [["css=button.btn-warning[type='submit']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c5-07",
          "comment": "Valida dado de saída esperado: Alerta de Sedentarismo gerado em tela",
          "command": "assertElementPresent",
          "target": "xpath=//strong[contains(.,'ALERTA DE SEDENTARISMO GERADO:')]",
          "targets": [["xpath=//strong[contains(.,'ALERTA DE SEDENTARISMO GERADO:')]", "xpath:innerText"]],
          "value": ""
        },
        {
          "id": "c5-08",
          "comment": "Valida dado de saída esperado: Novo Health Score calculado em 80.0 / 100",
          "command": "assertElementPresent",
          "target": "xpath=//span[contains(.,'80.0 / 100')]",
          "targets": [["xpath=//span[contains(.,'80.0 / 100')]", "xpath:innerText"]],
          "value": ""
        },
        {
          "id": "c5-09",
          "comment": "Acessa o Painel Admin (/admin/dashboard) para validar os alertas ativos consolidados",
          "command": "open",
          "target": "/admin/dashboard",
          "targets": [],
          "value": ""
        },
        {
          "id": "c5-10",
          "comment": "Valida que a tabela Alertas Clínicos Ativos exibe os alertas gerados",
          "command": "assertElementPresent",
          "target": "xpath=//span[contains(.,'Alertas Clínicos Ativos')]",
          "targets": [["xpath=//span[contains(.,'Alertas Clínicos Ativos')]", "xpath:innerText"]],
          "value": ""
        }
      ]
    }
  ],
  "suites": [
    {
      "id": "suite-pettrack-sprint4",
      "name": "Suíte Principal - PetTrack Sprint 4 (5 Casos de Teste)",
      "persistSession": true,
      "parallel": false,
      "timeout": 300,
      "tests": [
        "tc01-auth-rbac-403",
        "tc02-cadastro-pet-oracle",
        "tc03-validacao-form-negativo",
        "tc04-simulador-iot-febre",
        "tc05-simulador-iot-sedentarismo"
      ]
    }
  ],
  "urls": [
    "http://localhost:8080"
  ],
  "plugins": []
}
